NODE_ENV=production
PORT=5000

# MongoDB Atlas (M10+ or any replica set: orders use transactions)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/artisan?retryWrites=true&w=majority

# openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRE=30d

# Your public site URL(s), comma separated
CLIENT_ORIGIN=https://shop.example.com

# openssl rand -hex 32  (same value as the Worker secret ORIGIN_SECRET)
ORIGIN_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
