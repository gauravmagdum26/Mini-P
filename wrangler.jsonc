{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artisan-local",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  // Serve the Vite build. Unknown paths fall back to index.html (React Router).
  // Only /api/* is sent to the Worker; everything else is served from the edge.
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Non-secret config. Change to your real API origin (no trailing slash).
  "vars": {
    "ORIGIN_URL": "https://artisan-local-api.onrender.com"
  },

  // Attach your own domain (zone must be on Cloudflare), then uncomment:
  // "routes": [{ "pattern": "shop.example.com", "custom_domain": true }],

  "observability": { "enabled": true }

  // Secret (set with `npx wrangler secret put ORIGIN_SECRET`, never commit):
  //   ORIGIN_SECRET
}
